# Mu Environment Variables
# Copy to .env and modify as needed.
#
# IMPORTANT: env overrides only reach config keys that are already lowercase —
# the parser lowercases every path segment, so camelCase keys (server.logLevel,
# transcoding.hwAccel, thirdParty.tmdb.apiKey, …) CANNOT be set this way. Use
# data/config/config.yml for those, or the explicitly-supported variables below.
# API keys are best set in the UI: Settings -> Connections (stored encrypted).

# ── Server ────────────────────────────────────────────────────────────────
MU_SERVER__PORT=4000

# ── Paths ─────────────────────────────────────────────────────────────────
# Resolved relative to the PROJECT ROOT, not the current directory.
MU_DATA_DIR=./data
# MU_LOGS_DIR=./data/logs

# Cache root — put this on an SSD/NVMe if your media lives on a spinning disk.
# Anchors streams, images, sprites, subtitles and the hot cache.
# MU_CACHE_DIR=/mnt/nvme/mu-cache
# Override only the transcode-segment directory:
# MU_CACHE__STREAMDIR=/mnt/nvme/mu-cache/streams

# ── Background jobs ───────────────────────────────────────────────────────
# in-memory (default, zero deps) or bullmq (Redis-backed, multi-worker)
# MU_JOBS__BACKEND=in-memory
# MU_JOBS__REDIS__URL=redis://localhost:6379
# MU_JOBS__BULLMQ__CONCURRENCY=2

# ── Email (optional) ──────────────────────────────────────────────────────
# Powers feedback notifications and new-user email verification.
# MU_EMAIL_ENABLED=true
# MU_EMAIL_PROVIDER=brevo          # brevo | resend
# MU_EMAIL_BREVO_API_KEY=
# MU_EMAIL_RESEND_API_KEY=
# MU_EMAIL_FROM_ADDRESS=
# MU_EMAIL_FROM_NAME=Mu
# MU_EMAIL_REPLY_TO=
# MU_EMAIL_ADMIN_EMAIL=
# MU_EMAIL_SITE_URL=https://mu.example.com

# ── Misc ──────────────────────────────────────────────────────────────────
# Token for unattended internal access to /admin/logs/* (empty disables it).
# MU_AUTH_API_TOKEN=
# Force-exit window (ms) after SIGTERM during restarts.
# MU_SHUTDOWN_GRACE_MS=5000
